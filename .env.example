OPENROUTER_API_KEY="your api key"

# Optional shared fallback model, used only for any role below that
# isn't set explicitly. Kept for backward compatibility with earlier
# single-model configurations.
OPENROUTER_MODEL="your choice of model"

# Independent models per role. Keeping these on different model
# families preserves judge independence - see config/free_models.yaml
# for a curated list of free OpenRouter models per role. OpenRouter's
# free catalog changes often; verify at
# https://openrouter.ai/models?max_price=0 if a model 404s.
ATTACKER_MODEL="z-ai/glm-5.2:free"
TARGET_MODEL="google/gemma-4-26b-a4b-it:free"
JUDGE_MODEL="nvidia/nemotron-3-super-120b-a12b:free"

# Hard, always-on spend cap in USD, shared across every LLM call in
# the process (CLI scans, eval runs, ad hoc scripts alike) - not just
# scans that pass --budget. Every model role defaults to a :free
# tier, so this should never trip in normal use; it exists as a
# safety net against a misconfigured model id or a provider quietly
# moving a model from free to paid. Set to "none" to disable
# (not recommended).
PROMPTRED_SPEND_CAP_USD="0.01"

# Email reporting (Phase 6). Sender is your company address; the
# recipient is configured separately in config/recipients.yaml or via
# --email-to, and the CLI will prompt for one interactively if missing.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SENDER_EMAIL=""
