OPENROUTER_API_KEY="your api key"

# Models per role - the configuration every published number was
# measured with. Four different model families, so no judge grades its
# own family. Check https://openrouter.ai/models if a model id 404s.
ATTACKER_MODEL="z-ai/glm-5.3-flash"
TARGET_MODEL="liquid/lfm-2.5-2.6b:free"
JUDGE_MODEL="qwen/qwen3.8-27b"
# Second judge that checks every verdict (TypeSafe's Jev, a decision
# model). This is also the built-in default.
JUDGE_PANEL_SECOND_MODEL="typesafe/jev-1.13"

# Hard, always-on spend cap in USD for one process (scan, eval, script).
# A full 34-attack scan of one prompt costs about $0.14-0.20 and a live
# judge eval about $0.37, so 0.50 covers one of either with margin.
# Raise it for bigger runs; "none" disables it (not recommended).
PROMPTRED_SPEND_CAP_USD="0.50"

# Optional email reporting (only used with --email / --email-to).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SENDER_EMAIL=""
